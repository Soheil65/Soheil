@using DevExpress.Blazor
@using Microsoft.AspNetCore.Components
@inherits ComponentBase

<DxPopup Visible="@IsVisible" ShowCloseButton="true" Width="900px" Height="600px" CloseOnOutsideClick="true" VisibleChanged="OnVisibleChanged">
    <HeaderContentTemplate>
        <div class="d-flex align-items-center">
            <span class="h5 mb-0">Trip Route Map</span>
        </div>
    </HeaderContentTemplate>
    <ChildContent>
        <div style="width:100%;height:520px;">
            <DxMap Zoom="14"
                   Provider="MapProvider.Google"
                   ControlsVisible="true"
                   GoogleMapId="7cf5e0ad5e2577af820467e1"
                   Width="100%" Height="600px">
                <DxMapApiKeys Google="AIzaSyDwMaKPrh5qVNMOJ9_wIpIKOeVpuzEWc4w" /> 
 
                <DxMapMarkers>
                    <DxMapMarker>
                        <DxMapMarkerLocation GeoPosition="40.7825, -73.966111" />
                        <DxMapMarkerTooltip Text="Point 1" />
                    </DxMapMarker>
                    <DxMapMarker>
                        <DxMapMarkerLocation GeoPosition="40.755833, -73.986389" />
                        <DxMapMarkerTooltip Text="Point 2" />
                    </DxMapMarker>
                    <DxMapMarker>
                        <DxMapMarkerLocation Latitude="40.753889" Longitude="-73.981389" />
                        <DxMapMarkerTooltip Text="Point 3" />
                    </DxMapMarker>
                    <DxMapMarker>
                        <DxMapMarkerLocation GeoPosition="Brooklyn Bridge,New York,NY" />
                        <DxMapMarkerTooltip Text="Point 4" />
                    </DxMapMarker>
                </DxMapMarkers>
                <DxMapRoutes>
                    <DxMapRoute Weight="9" Color="@CurrentRouteColor" Mode="@CurrentRouteMode">
                        <DxMapRouteLocations>
                            <DxMapRouteLocation Latitude="40.782500" Longitude="-73.966111" />
                            <DxMapRouteLocation Latitude="40.755833" Longitude="-73.986389" />
                            <DxMapRouteLocation GeoPosition="40.753889, -73.981389" />
                            <DxMapRouteLocation GeoPosition="Brooklyn Bridge,New York,NY" />
                        </DxMapRouteLocations>
                    </DxMapRoute>
                </DxMapRoutes>
            </DxMap>
        </div>
    </ChildContent>
</DxPopup>



@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }
    [Parameter] public List<(double lat, double lon)> Stops { get; set; } = new();
    [Parameter] public string? GoogleMapsApiKey { get; set; }

    MapRouteMode CurrentRouteMode = MapRouteMode.Driving;
    static string[] Colors = new string[] { "blue", "green", "red", "magenta", "yellow" };
    string CurrentRouteColor = Colors[0];

    private Task OnVisibleChanged(bool value)
    {
        IsVisible = value;
        return IsVisibleChanged.InvokeAsync(value);
    }
}