@page "/"

<PageTitle>Home - Pharmatrack</PageTitle>

<div class="container">
    <h1>Welcome to Pharmatrack</h1>
    <p class="lead">Your comprehensive pharmacy management solution</p>
    
    <div class="row mt-4">
        <div class="col-md-4 mb-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Product Management</h5>
                    <p class="card-text">Manage your pharmacy inventory with ease.</p>
                    <a href="/products" class="btn btn-primary">View Products</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">About Us</h5>
                    <p class="card-text">Learn more about Pharmatrack and our mission.</p>
                    <a href="/about" class="btn btn-primary">Learn More</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Getting Started</h5>
                    <p class="card-text">New to Pharmatrack? Start here!</p>
                    <a href="/about" class="btn btn-primary">Get Started</a>
                </div>
            </div>
        </div>
    </div>
</div>
