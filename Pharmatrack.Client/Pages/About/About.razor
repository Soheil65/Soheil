@page "/about"

<PageTitle>About - Pharmatrack</PageTitle>

<div class="container">
    <h1>About Pharmatrack</h1>
    
    <div class="row mt-4">
        <div class="col-md-8">
            <h3>Our Mission</h3>
            <p>
                Pharmatrack is designed to streamline pharmacy operations and improve patient care. 
                Our comprehensive solution helps pharmacies manage their inventory, track medications, 
                and ensure regulatory compliance.
            </p>
            
            <h3 class="mt-4">Features</h3>
            <ul>
                <li>Real-time inventory management</li>
                <li>Product tracking and categorization</li>
                <li>User-friendly interface</li>
                <li>RESTful API integration</li>
                <li>Responsive design for all devices</li>
            </ul>
            
            <h3 class="mt-4">Technology Stack</h3>
            <ul>
                <li>.NET 9</li>
                <li>Blazor WebAssembly</li>
                <li>ASP.NET Core Web API</li>
                <li>Bootstrap 5</li>
            </ul>
        </div>
        <div class="col-md-4">
            <div class="card bg-light">
                <div class="card-body">
                    <h5 class="card-title">Contact Information</h5>
                    <p class="card-text">
                        <strong>Email:</strong> info@pharmatrack.com<br/>
                        <strong>Phone:</strong> (555) 123-4567<br/>
                        <strong>Address:</strong> 123 Pharmacy Lane, Medical City
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
