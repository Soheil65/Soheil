@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }
    [Parameter] public List<(double lat, double lon)> Stops { get; set; } = new();
    [Parameter] public string? GoogleMapsApiKey { get; set; }

    private Task OnVisibleChanged(bool value)
    {
        IsVisible = value;
        return IsVisibleChanged.InvokeAsync(value);
    }

    private string GetGoogleMapsEmbedUrl()
    {
        if (Stops == null || !Stops.Any())
            return string.Empty;

        // Google Maps Embed Directions API automatically labels stops as A, B, C, etc. in sequence
        var origin = $"{Stops.First().lat},{Stops.First().lon}";
        var destination = $"{Stops.Last().lat},{Stops.Last().lon}";
        
        // Middle stops as waypoints - Google will label these B, C, D, etc.
        var waypoints = string.Empty;
        if (Stops.Count > 2)
        {
            var middleStops = Stops.Skip(1).Take(Stops.Count - 2)
                .Select(s => $"{s.lat},{s.lon}");
            waypoints = "&waypoints=" + string.Join("|", middleStops);
        }

        var apiKey = !string.IsNullOrEmpty(GoogleMapsApiKey) ? $"&key={GoogleMapsApiKey}" : string.Empty;
        
        // The directions mode will show: A (origin), B, C, D... (waypoints), and final letter (destination)
        return $"https://www.google.com/maps/embed/v1/directions?origin={origin}&destination={destination}{waypoints}&mode=driving{apiKey}";
    }
}
 *@