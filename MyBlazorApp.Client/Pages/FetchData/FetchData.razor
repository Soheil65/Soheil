@page "/fetchdata"
@using MyBlazorApp.ViewModels.ViewModels
@using MyBlazorApp.ServerConnector.Connectors
@inject IWeatherConnector WeatherConnector
@inject MyBlazorApp.Client.Services.IAppStateService AppState

<PageTitle>Weather forecast</PageTitle>

<h1>Weather forecast</h1>

<p>This component demonstrates fetching data from the server using the ServerConnector.</p>

@if (forecasts == null)
{
    <p><em>Loading...</em></p>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Temp. (C)</th>
                <th>Temp. (F)</th>
                <th>Summary</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var forecast in forecasts)
            {
                <tr>
                    <td>@forecast.Date.ToShortDateString()</td>
                    <td>@forecast.TemperatureC</td>
                    <td>@forecast.TemperatureF</td>
                    <td>@forecast.Summary</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<WeatherForecastViewModel>? forecasts;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            AppState.IsLoading = true;
            var response = await WeatherConnector.GetWeatherForecastAsync();
            
            if (response.Success && response.Data != null)
            {
                forecasts = response.Data;
            }
            else
            {
                errorMessage = response.Message ?? "Failed to load weather data";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            AppState.IsLoading = false;
        }
    }
}
