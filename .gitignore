## =========================
## NuGet / Packages
## =========================
# NuGet local packs and props generated by restore
*.nupkg
*.snupkg
*.nuget.props
*.nuget.targets

# Legacy packages folder (rare with modern restore)
**/packages/*
!**/packages/build/

## =========================
## API / Data (local-only stuff)
## =========================
# Local DBs / dev-only stores
*.mdf
*.ldf
*.sqlite
*.db
*.db-shm
*.db-wal

# App configuration (keep normal appsettings, ignore local secrets)
appsettings.*.Local.json
appsettings.Local.json

# User secrets live outside repo by default; this is just a safeguard
secrets.json

